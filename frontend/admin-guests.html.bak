<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guests Management — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: { extend: {
        colors: { navy:"#0B1F33", navy2:"#102A43", gold:"#C7A46A", cream:"#F8F6F1", soft:"#F3F5F7", teal:"#1E8A8A" },
        fontFamily: { sans:["DM Sans","sans-serif"], serif:["Playfair Display","serif"] }
      }}
    }
  </script>
  <style>
    * { box-sizing: border-box; }
    body { margin:0; font-family:"DM Sans",sans-serif; background:#F3F5F7; color:#0B1F33; }
    .font-serif { font-family:"Playfair Display",serif; }

    .sidebar { width:260px; background:linear-gradient(180deg,#0B1F33 0%,#102A43 100%); min-height:100vh; position:fixed; left:0; top:0; z-index:40; transition:transform .3s ease; }
    .sidebar-link { display:flex; align-items:center; gap:14px; padding:13px 22px; color:#94a3b8; text-decoration:none; font-size:14px; font-weight:500; border-left:3px solid transparent; transition:all .25s ease; }
    .sidebar-link:hover { color:#fff; background:rgba(255,255,255,.05); }
    .sidebar-link.active { color:#fff; background:rgba(199,164,106,.15); border-left-color:#C7A46A; }
    .sidebar-link.active i { color:#C7A46A; }
    .sidebar-link i { width:20px; text-align:center; font-size:16px; }
    .sidebar-section-label { padding:20px 22px 8px; color:#64748b; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:2px; }

    .main-content { margin-left:260px; min-height:100vh; }
    @media (max-width:1023px) {
      .sidebar { transform:translateX(-100%); }
      .sidebar.open { transform:translateX(0); }
      .main-content { margin-left:0; }
    }

    .topbar { background:#fff; border-bottom:1px solid #e5e7eb; padding:16px 28px; position:sticky; top:0; z-index:30; }
    .card { background:#fff; border-radius:18px; padding:24px; border:1px solid #eef2f7; }

    .stat-card { background:#fff; border-radius:18px; padding:20px; border:1px solid #eef2f7; transition:all .3s ease; }
    .stat-card:hover { transform:translateY(-3px); box-shadow:0 12px 30px rgba(11,31,51,.08); }
    .stat-icon { width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px; }

    /* Guest Table */
    .guest-table { width:100%; border-collapse:separate; border-spacing:0; }
    .guest-table th { text-align:left; padding:14px 18px; background:#f8fafc; color:#64748b; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; border-bottom:1px solid #eef2f7; }
    .guest-table td { padding:16px 18px; border-bottom:1px solid #f1f5f9; font-size:14px; color:#334155; vertical-align:middle; }
    .guest-table tbody tr { cursor:pointer; transition:background .15s; }
    .guest-table tbody tr:hover { background:#fafbfc; }

    .avatar-circle { width:42px; height:42px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-weight:700; color:#fff; font-size:16px; flex-shrink:0; }

    .role-badge { padding:4px 10px; border-radius:999px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; display:inline-block; }
    .role-ADMIN { background:#fee2e2; color:#991b1b; }
    .role-USER { background:#dbeafe; color:#1e40af; }

    .status-dot { width:8px; height:8px; border-radius:50%; display:inline-block; }
    .status-active { background:#22c55e; }
    .status-inactive { background:#ef4444; }
    .status-staying { background:#eab308; animation:pulse 1.5s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:.5;} }

    .btn-gold { background:#C7A46A; color:#fff; transition:.25s ease; border:none; }
    .btn-gold:hover { background:#aa884e; color:#fff; }
    .btn-navy { background:#0B1F33; color:#fff; transition:.25s ease; border:none; }
    .btn-navy:hover { background:#102A43; color:#fff; }

    .search-input { padding:11px 16px 11px 42px; border:2px solid #e5e7eb; border-radius:12px; outline:none; transition:all .25s ease; font-size:14px; width:100%; }
    .search-input:focus { border-color:#C7A46A; box-shadow:0 0 0 4px rgba(199,164,106,.12); }
    .search-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#9ca3af; }

    .filter-select { padding:10px 16px; border:2px solid #e5e7eb; border-radius:12px; outline:none; font-size:13px; background:#fff; cursor:pointer; font-weight:500; }
    .filter-select:focus { border-color:#C7A46A; }

    .spinner { display:inline-block; width:40px; height:40px; border:4px solid rgba(199,164,106,.25); border-top-color:#C7A46A; border-radius:50%; animation:spin .8s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }

    /* Profile Drawer */
    .drawer-overlay { position:fixed; inset:0; background:rgba(11,31,51,.5); backdrop-filter:blur(4px); z-index:90; opacity:0; pointer-events:none; transition:opacity .3s ease; }
    .drawer-overlay.active { opacity:1; pointer-events:auto; }
    .drawer { position:fixed; top:0; right:0; width:100%; max-width:640px; height:100vh; background:#F3F5F7; z-index:100; overflow-y:auto; transform:translateX(100%); transition:transform .35s cubic-bezier(.4,0,.2,1); }
    .drawer.active { transform:translateX(0); }
    .drawer-header { background:linear-gradient(135deg,#0B1F33,#102A43); padding:32px; color:#fff; position:sticky; top:0; z-index:5; }

    .icon-btn { width:36px; height:36px; border-radius:9px; display:inline-flex; align-items:center; justify-content:center; transition:all .2s ease; border:none; cursor:pointer; }
    .icon-btn-blue { background:#dbeafe; color:#2563eb; }
    .icon-btn-blue:hover { background:#2563eb; color:#fff; }
    .icon-btn-red { background:#fee2e2; color:#dc2626; }
    .icon-btn-red:hover { background:#dc2626; color:#fff; }
    .icon-btn-green { background:#dcfce7; color:#16a34a; }
    .icon-btn-green:hover { background:#16a34a; color:#fff; }

    .booking-row { background:#fff; border-radius:14px; padding:18px; border:1px solid #eef2f7; margin-bottom:12px; transition:all .2s ease; cursor:pointer; }
    .booking-row:hover { box-shadow:0 8px 25px rgba(11,31,51,.08); transform:translateY(-2px); }

    .badge { padding:4px 10px; border-radius:999px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; }
    .badge-PENDING { background:#fef3c7; color:#92400e; }
    .badge-CONFIRMED { background:#d1fae5; color:#065f46; }
    .badge-CANCELLED { background:#fee2e2; color:#991b1b; }
    .badge-COMPLETED { background:#dbeafe; color:#1e40af; }

    .timeline-item { position:relative; padding-left:40px; padding-bottom:24px; }
    .timeline-item::before { content:""; position:absolute; left:14px; top:24px; bottom:0; width:2px; background:#e2e8f0; }
    .timeline-item:last-child::before { display:none; }
    .timeline-icon { position:absolute; left:0; top:0; width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:12px; }

    .fade-up { animation:fadeUp .5s ease both; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(15px);} to{opacity:1;transform:translateY(0);} }

    .custom-scroll::-webkit-scrollbar { width:6px; }
    .custom-scroll::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:6px; }

    .empty-state { border:1px dashed #ccd4db; background:rgba(255,255,255,.65); border-radius:2rem; }
  </style>
</head>
<body>

<!-- SIDEBAR -->
<aside id="sidebar" class="sidebar">
  <div class="flex items-center gap-3 px-6 py-6 border-b border-white/10">
    <div class="w-11 h-11 rounded-2xl bg-gold flex items-center justify-center text-white">
      <i class="fa-solid fa-hotel text-xl"></i>
    </div>
    <div>
      <div class="text-lg font-bold text-white">Hotel<span class="text-gold">Reserve</span></div>
      <div class="text-[9px] tracking-[3px] uppercase text-gray-400">Admin Panel</div>
    </div>
  </div>

  <div class="py-3 overflow-y-auto custom-scroll" style="height:calc(100vh - 90px);">
    <div class="sidebar-section-label">Main</div>
    <a href="admin.html" class="sidebar-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
    <a href="admin-bookings.html" class="sidebar-link"><i class="fa-solid fa-calendar-check"></i><span>Bookings</span></a>
    <a href="admin-rooms.html" class="sidebar-link"><i class="fa-solid fa-bed"></i><span>Rooms</span></a>
    <a href="admin-guests.html" class="sidebar-link active"><i class="fa-solid fa-users"></i><span>Guests</span></a>
    <a href="admin-checkin.html" class="sidebar-link"><i class="fa-solid fa-door-open"></i><span>Check-in / Check-out</span></a>
    <div class="sidebar-section-label">Operations</div>
    <a href="admin-payments.html" class="sidebar-link"><i class="fa-solid fa-credit-card"></i><span>Payments</span></a>
    <a href="admin-housekeeping.html" class="sidebar-link"><i class="fa-solid fa-broom"></i><span>Housekeeping</span></a>
    <a href="admin-reports.html" class="sidebar-link"><i class="fa-solid fa-chart-pie"></i><span>Reports</span></a>
    <div class="sidebar-section-label">System</div>
    <a href="admin-settings.html" class="sidebar-link"><i class="fa-solid fa-gear"></i><span>Settings</span></a>
    <a href="#" onclick="logout()" class="sidebar-link text-red-400 hover:text-red-300"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></a>
  </div>
</aside>

<!-- MAIN -->
<div class="main-content">
  <div class="topbar">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <button onclick="toggleSidebar()" class="lg:hidden text-navy text-xl"><i class="fa-solid fa-bars"></i></button>
        <div>
          <h1 class="text-xl font-bold text-navy mb-0">Guests Management</h1>
          <p class="text-xs text-gray-500 mb-0">Manage guests and customer profiles</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <button onclick="exportGuests()" class="btn-navy px-4 py-2.5 rounded-lg text-xs font-semibold">
          <i class="fa-solid fa-download mr-2"></i>Export CSV
        </button>
        <div class="flex items-center gap-3 pl-3 border-l border-gray-200">
          <div class="hidden md:block text-right">
            <div class="text-sm font-semibold text-navy" id="adminName">Admin</div>
            <div class="text-xs text-gray-500">Administrator</div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-gold flex items-center justify-center text-white font-bold" id="adminInitial">A</div>
        </div>
      </div>
    </div>
  </div>

  <div class="p-6 lg:p-8">

    <div id="loading" class="text-center py-24">
      <div class="spinner mx-auto"></div>
      <p class="text-gray-500 mt-4">Loading guests...</p>
    </div>

    <div id="content" class="hidden">

      <!-- STATS -->
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6 fade-up">
        <div class="stat-card">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider">Total Guests</div>
            <div class="stat-icon bg-blue-50 text-blue-600"><i class="fa-solid fa-users"></i></div>
          </div>
          <div class="font-serif text-3xl font-bold text-navy" id="statTotal">0</div>
        </div>
        <div class="stat-card">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider">Active</div>
            <div class="stat-icon bg-green-50 text-green-600"><i class="fa-solid fa-circle-check"></i></div>
          </div>
          <div class="font-serif text-3xl font-bold text-green-600" id="statActive">0</div>
        </div>
        <div class="stat-card">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider">Currently Staying</div>
            <div class="stat-icon bg-yellow-50 text-yellow-600"><i class="fa-solid fa-hotel"></i></div>
          </div>
          <div class="font-serif text-3xl font-bold text-yellow-600" id="statStaying">0</div>
        </div>
        <div class="stat-card">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider">Total Bookings</div>
            <div class="stat-icon bg-purple-50 text-purple-600"><i class="fa-solid fa-calendar-check"></i></div>
          </div>
          <div class="font-serif text-3xl font-bold text-purple-600" id="statBookings">0</div>
        </div>
        <div class="stat-card">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider">Revenue</div>
            <div class="stat-icon bg-[#f7f0e4] text-gold"><i class="fa-solid fa-money-bill-wave"></i></div>
          </div>
          <div class="font-serif text-xl font-bold text-navy">৳<span id="statRevenue">0</span></div>
        </div>
      </div>

      <!-- FILTER BAR -->
      <div class="card mb-6 fade-up">
        <div class="grid md:grid-cols-12 gap-4">
          <div class="md:col-span-5 relative">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" id="searchInput" class="search-input" placeholder="Search by name, email or phone...">
          </div>

          <div class="md:col-span-2">
            <select id="roleFilter" class="filter-select w-full">
              <option value="">All Roles</option>
              <option value="USER">User</option>
              <option value="ADMIN">Admin</option>
            </select>
          </div>

          <div class="md:col-span-2">
            <select id="statusFilter" class="filter-select w-full">
              <option value="">All Status</option>
              <option value="ACTIVE">Active</option>
              <option value="INACTIVE">Inactive</option>
              <option value="STAYING">Currently Staying</option>
            </select>
          </div>

          <div class="md:col-span-3">
            <select id="sortFilter" class="filter-select w-full">
              <option value="recent">Recently Joined</option>
              <option value="bookings">Most Bookings</option>
              <option value="spent">Highest Spending</option>
              <option value="name">Name (A-Z)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- TABLE -->
      <div class="card fade-up" style="padding:0; overflow:hidden;">
        <div class="overflow-x-auto custom-scroll">
          <table class="guest-table" style="min-width:1000px;">
            <thead>
              <tr>
                <th>Guest</th>
                <th>Contact</th>
                <th>Role</th>
                <th>Bookings</th>
                <th>Total Spent</th>
                <th>Last Stay</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="guestsBody">
              <tr><td colspan="8" class="text-center py-12 text-gray-400">Loading...</td></tr>
            </tbody>
          </table>
        </div>

        <div id="emptyState" class="hidden text-center py-16">
          <i class="fa-solid fa-user-slash text-4xl text-gray-300 mb-3"></i>
          <h3 class="font-serif text-xl font-semibold text-gray-500 mb-2">No guests found</h3>
          <p class="text-gray-400 text-sm">Try changing your search or filter</p>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- PROFILE DRAWER -->
<div id="drawerOverlay" class="drawer-overlay" onclick="closeDrawer()"></div>
<aside id="profileDrawer" class="drawer custom-scroll">
  <div class="drawer-header">
    <div class="flex items-center justify-between mb-4">
      <button onclick="closeDrawer()" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 flex items-center justify-center transition border-0 text-white">
        <i class="fa-solid fa-arrow-left"></i>
      </button>
      <div class="flex gap-2">
        <button id="toggleStatusBtn" onclick="toggleGuestStatus()" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-sm font-semibold transition border-0 text-white">
          <i class="fa-solid fa-power-off mr-2"></i>Toggle Status
        </button>
        <button id="deleteGuestBtn" onclick="deleteGuest()" class="px-4 py-2 rounded-xl bg-red-500 hover:bg-red-600 text-sm font-semibold transition border-0 text-white">
          <i class="fa-solid fa-trash mr-2"></i>Delete
        </button>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <div class="w-20 h-20 rounded-2xl flex items-center justify-center font-bold text-white text-3xl" id="drawerAvatar">A</div>
      <div class="flex-1">
        <h2 class="font-serif text-3xl font-semibold mb-1" id="drawerName">Guest Name</h2>
        <div class="text-sm text-gray-300 mb-2" id="drawerEmail">email@example.com</div>
        <div class="flex flex-wrap gap-2">
          <span id="drawerRole" class="role-badge role-USER">USER</span>
          <span id="drawerStatus" class="role-badge" style="background:#d1fae5;color:#065f46;">ACTIVE</span>
          <span id="drawerTier" class="role-badge" style="background:linear-gradient(135deg,#FFD700,#FFA500);color:#fff;">BRONZE</span>
        </div>
      </div>
    </div>
  </div>

  <div class="p-6 space-y-6">

    <!-- STATS -->
    <div class="grid grid-cols-3 gap-3">
      <div class="bg-white rounded-2xl p-4 border border-gray-100">
        <div class="text-[10px] text-gray-400 uppercase tracking-wider font-bold mb-1">Bookings</div>
        <div class="font-serif text-2xl font-bold text-navy" id="dStatBookings">0</div>
      </div>
      <div class="bg-white rounded-2xl p-4 border border-gray-100">
        <div class="text-[10px] text-gray-400 uppercase tracking-wider font-bold mb-1">Total Spent</div>
        <div class="font-serif text-xl font-bold text-navy">৳<span id="dStatSpent">0</span></div>
      </div>
      <div class="bg-white rounded-2xl p-4 border border-gray-100">
        <div class="text-[10px] text-gray-400 uppercase tracking-wider font-bold mb-1">Avg/Stay</div>
        <div class="font-serif text-xl font-bold text-navy">৳<span id="dStatAvg">0</span></div>
      </div>
    </div>

    <!-- CURRENT STAY -->
    <div id="currentStaySection" class="hidden">
      <h3 class="font-serif text-lg font-semibold text-navy mb-3 flex items-center gap-2">
        <i class="fa-solid fa-bed text-gold"></i>Current Stay
      </h3>
      <div id="currentStayContent" class="bg-gradient-to-br from-navy to-navy2 rounded-2xl p-5 text-white"></div>
    </div>

    <!-- CONTACT INFO -->
    <div>
      <h3 class="font-serif text-lg font-semibold text-navy mb-3 flex items-center gap-2">
        <i class="fa-solid fa-address-card text-gold"></i>Contact Information
      </h3>
      <div class="bg-white rounded-2xl p-5 border border-gray-100 space-y-3">
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Email</span>
          <span class="font-semibold text-navy" id="dEmail">—</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Phone</span>
          <span class="font-semibold text-navy" id="dPhone">—</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Member Since</span>
          <span class="font-semibold text-navy" id="dJoined">—</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Email Verified</span>
          <span class="font-semibold text-navy" id="dVerified">—</span>
        </div>
      </div>
    </div>

    <!-- BOOKING HISTORY -->
    <div>
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-serif text-lg font-semibold text-navy flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left text-gold"></i>Booking History
        </h3>
        <span class="text-xs text-gray-500" id="dBookingCount">0 bookings</span>
      </div>
      <div id="bookingHistory" class="space-y-2"></div>
    </div>

  </div>
</aside>

<script src="https://cdn.jsdelivr.net/npm/axios@1.7.7/dist/axios.min.js"></script>
<script>
  const API_BASE_URL = "http://localhost:8080/api";
  const api = axios.create({ baseURL: API_BASE_URL });
  const token = localStorage.getItem("accessToken");

  if (token) api.defaults.headers.common["Authorization"] = `Bearer ${token}`;
  else window.location.href = "login.html";

  const user = JSON.parse(localStorage.getItem("user") || "null");
  if (!user || user.role !== "ADMIN") window.location.href = "index.html";

  document.getElementById("adminName").textContent = user.name;
  document.getElementById("adminInitial").textContent = user.name.charAt(0).toUpperCase();

  let allGuests = [];
  let currentGuest = null;

  function toggleSidebar() { document.getElementById("sidebar").classList.toggle("open"); }
  function logout() { localStorage.clear(); window.location.href = "index.html"; }

  const avatarColors = ['#3b82f6','#8b5cf6','#ec4899','#f59e0b','#10b981','#06b6d4','#6366f1','#ef4444'];
  function getAvatarColor(name) {
    let hash = 0;
    for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
    return avatarColors[Math.abs(hash) % avatarColors.length];
  }

  function formatDate(dateStr) {
    if (!dateStr) return '—';
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  // Load stats + guests
  async function loadAll() {
    try {
      const [statsRes, guestsRes] = await Promise.all([
        api.get("/admin/guests/stats"),
        api.get("/admin/guests")
      ]);

      const stats = statsRes.data.data;
      document.getElementById("statTotal").textContent = stats.totalGuests;
      document.getElementById("statActive").textContent = stats.activeGuests;
      document.getElementById("statStaying").textContent = stats.currentlyStaying;
      document.getElementById("statBookings").textContent = stats.totalBookings;
      document.getElementById("statRevenue").textContent = parseFloat(stats.totalRevenue).toLocaleString('en-BD');

      allGuests = guestsRes.data.data || [];
      document.getElementById("loading").classList.add("hidden");
      document.getElementById("content").classList.remove("hidden");
      renderGuests();

    } catch (err) {
      console.error(err);
      document.getElementById("loading").innerHTML = `
        <div class="text-center">
          <i class="fa-solid fa-circle-exclamation text-red-500 text-5xl mb-4"></i>
          <h3 class="font-serif text-2xl font-semibold mb-2">Unable to load</h3>
          <button onclick="location.reload()" class="btn-navy px-5 py-2 rounded-lg text-sm mt-2">Retry</button>
        </div>`;
    }
  }

  // Filter + Search
  document.getElementById("searchInput").addEventListener("input", renderGuests);
  document.getElementById("roleFilter").addEventListener("change", renderGuests);
  document.getElementById("statusFilter").addEventListener("change", renderGuests);
  document.getElementById("sortFilter").addEventListener("change", renderGuests);

  function getFilteredGuests() {
    const search = document.getElementById("searchInput").value.toLowerCase().trim();
    const role = document.getElementById("roleFilter").value;
    const status = document.getElementById("statusFilter").value;
    const sort = document.getElementById("sortFilter").value;

    let filtered = allGuests.filter(g => {
      if (search) {
        const matches = (g.name || "").toLowerCase().includes(search)
                     || (g.email || "").toLowerCase().includes(search)
                     || (g.phone || "").includes(search);
        if (!matches) return false;
      }
      if (role && g.role !== role) return false;
      if (status === "ACTIVE" && !g.enabled) return false;
      if (status === "INACTIVE" && g.enabled) return false;
      if (status === "STAYING" && !g.currentlyStaying) return false;
      return true;
    });

    if (sort === "recent") filtered.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
    else if (sort === "bookings") filtered.sort((a,b) => (b.totalBookings || 0) - (a.totalBookings || 0));
    else if (sort === "spent") filtered.sort((a,b) => parseFloat(b.totalSpent || 0) - parseFloat(a.totalSpent || 0));
    else if (sort === "name") filtered.sort((a,b) => (a.name || "").localeCompare(b.name || ""));

    return filtered;
  }

  function renderGuests() {
    const guests = getFilteredGuests();
    const tbody = document.getElementById("guestsBody");
    const empty = document.getElementById("emptyState");

    if (!guests.length) {
      tbody.innerHTML = "";
      empty.classList.remove("hidden");
      return;
    }

    empty.classList.add("hidden");

    tbody.innerHTML = guests.map(g => {
      const color = getAvatarColor(g.name || "X");
      const initial = (g.name || "?").charAt(0).toUpperCase();

      let statusHtml = '';
      if (g.currentlyStaying) {
        statusHtml = '<span class="status-dot status-staying"></span> <span class="text-xs font-semibold text-yellow-700">Staying</span>';
      } else if (g.enabled) {
        statusHtml = '<span class="status-dot status-active"></span> <span class="text-xs font-semibold text-green-700">Active</span>';
      } else {
        statusHtml = '<span class="status-dot status-inactive"></span> <span class="text-xs font-semibold text-red-700">Inactive</span>';
      }

      return `
        <tr onclick="openGuest(${g.id})">
          <td>
            <div class="flex items-center gap-3">
              <div class="avatar-circle" style="background:${color}">${initial}</div>
              <div>
                <div class="font-semibold text-navy">${g.name}</div>
                <div class="text-xs text-gray-400">ID: #${g.id}</div>
              </div>
            </div>
          </td>
          <td>
            <div class="text-sm">${g.email}</div>
            <div class="text-xs text-gray-400">${g.phone || '—'}</div>
          </td>
          <td><span class="role-badge role-${g.role}">${g.role}</span></td>
          <td><span class="font-semibold">${g.totalBookings || 0}</span></td>
          <td class="font-semibold text-navy">৳${parseFloat(g.totalSpent || 0).toLocaleString('en-BD')}</td>
          <td class="text-sm text-gray-600">${g.lastStayDate ? formatDate(g.lastStayDate) : '—'}</td>
          <td>${statusHtml}</td>
          <td class="text-right">
            <button onclick="event.stopPropagation(); openGuest(${g.id})" class="icon-btn icon-btn-blue" title="View">
              <i class="fa-solid fa-eye text-xs"></i>
            </button>
          </td>
        </tr>
      `;
    }).join("");
  }

  // Open guest profile
  async function openGuest(id) {
    try {
      const res = await api.get(`/admin/guests/${id}`);
      const g = res.data.data;
      currentGuest = g;

      const color = getAvatarColor(g.name);
      document.getElementById("drawerAvatar").style.background = color;
      document.getElementById("drawerAvatar").textContent = (g.name || "?").charAt(0).toUpperCase();
      document.getElementById("drawerName").textContent = g.name;
      document.getElementById("drawerEmail").textContent = g.email;

      const roleEl = document.getElementById("drawerRole");
      roleEl.className = `role-badge role-${g.role}`;
      roleEl.textContent = g.role;

      const statusEl = document.getElementById("drawerStatus");
      if (g.enabled) {
        statusEl.style.background = "#d1fae5";
        statusEl.style.color = "#065f46";
        statusEl.textContent = "ACTIVE";
      } else {
        statusEl.style.background = "#fee2e2";
        statusEl.style.color = "#991b1b";
        statusEl.textContent = "INACTIVE";
      }

      document.getElementById("drawerTier").textContent = g.tier || "BRONZE";

      document.getElementById("dStatBookings").textContent = g.totalBookings || 0;
      document.getElementById("dStatSpent").textContent = parseFloat(g.totalSpent || 0).toLocaleString('en-BD');
      document.getElementById("dStatAvg").textContent = parseFloat(g.averageBooking || 0).toLocaleString('en-BD');

      document.getElementById("dEmail").textContent = g.email;
      document.getElementById("dPhone").textContent = g.phone || "—";
      document.getElementById("dJoined").textContent = formatDate(g.createdAt);
      document.getElementById("dVerified").textContent = g.emailVerified ? "✓ Verified" : "✗ Not verified";

      // Current stay
      if (g.currentlyStaying) {
        document.getElementById("currentStaySection").classList.remove("hidden");
        // find current booking
        const bookRes = await api.get(`/admin/guests/${id}/bookings`);
        const bookings = bookRes.data.data || [];
        const now = new Date();
        const current = bookings.find(b => 
          b.status === "CONFIRMED" && new Date(b.checkIn) <= now && new Date(b.checkOut) > now
        );
        if (current) {
          document.getElementById("currentStayContent").innerHTML = `
            <div class="flex items-center justify-between mb-3">
              <div class="text-xs uppercase tracking-wider opacity-70">Room ${current.roomNumber}</div>
              <span class="badge badge-CONFIRMED">Checked In</span>
            </div>
            <div class="font-serif text-2xl font-semibold mb-2">${current.roomType}</div>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div><span class="opacity-70">Check-in</span><br><span class="font-semibold">${formatDate(current.checkIn)}</span></div>
              <div><span class="opacity-70">Check-out</span><br><span class="font-semibold">${formatDate(current.checkOut)}</span></div>
            </div>
          `;
        }
      } else {
        document.getElementById("currentStaySection").classList.add("hidden");
      }

      // Booking history
      const bookRes = await api.get(`/admin/guests/${id}/bookings`);
      const bookings = bookRes.data.data || [];
      document.getElementById("dBookingCount").textContent = `${bookings.length} bookings`;

      const history = document.getElementById("bookingHistory");
      if (bookings.length === 0) {
        history.innerHTML = `<div class="text-center py-8 text-gray-400 text-sm bg-white rounded-2xl border border-gray-100">No bookings yet</div>`;
      } else {
        history.innerHTML = bookings.slice(0, 10).map(b => `
          <div class="booking-row">
            <div class="flex items-center justify-between mb-2">
              <div class="text-xs font-bold text-navy">#BK${b.id.toString().padStart(4,'0')}</div>
              <span class="badge badge-${b.status}">${b.status}</span>
            </div>
            <div class="font-semibold text-navy mb-1">${b.roomType} · Room ${b.roomNumber}</div>
            <div class="flex items-center justify-between text-xs text-gray-500">
              <span><i class="fa-solid fa-calendar mr-1"></i>${formatDate(b.checkIn)} — ${formatDate(b.checkOut)}</span>
              <span class="font-bold text-navy text-sm">৳${parseFloat(b.totalPrice).toLocaleString('en-BD')}</span>
            </div>
          </div>
        `).join("");
      }

      document.getElementById("drawerOverlay").classList.add("active");
      document.getElementById("profileDrawer").classList.add("active");

    } catch (err) {
      alert("Failed to load guest: " + (err.response?.data?.message || err.message));
    }
  }

  function closeDrawer() {
    document.getElementById("drawerOverlay").classList.remove("active");
    document.getElementById("profileDrawer").classList.remove("active");
    currentGuest = null;
  }

  // Toggle status
  async function toggleGuestStatus() {
    if (!currentGuest) return;
    try {
      await api.patch(`/admin/guests/${currentGuest.id}/status?enabled=${!currentGuest.enabled}`);
      closeDrawer();
      await loadAll();
    } catch (err) {
      alert("Failed: " + (err.response?.data?.message || err.message));
    }
  }

  // Delete
  async function deleteGuest() {
    if (!currentGuest) return;
    if (!confirm(`Delete ${currentGuest.name}? This cannot be undone.`)) return;
    try {
      await api.delete(`/admin/guests/${currentGuest.id}`);
      closeDrawer();
      await loadAll();
    } catch (err) {
      alert("Failed: " + (err.response?.data?.message || err.message));
    }
  }

  // Export CSV
  function exportGuests() {
    const guests = getFilteredGuests();
    const headers = ["ID","Name","Email","Phone","Role","Bookings","Total Spent","Status","Joined"];
    const rows = guests.map(g => [
      g.id, g.name, g.email, g.phone || "", g.role,
      g.totalBookings || 0,
      parseFloat(g.totalSpent || 0).toFixed(2),
      g.enabled ? "Active" : "Inactive",
      formatDate(g.createdAt)
    ]);

    let csv = headers.join(",") + "\n";
    rows.forEach(r => {
      csv += r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(",") + "\n";
    });

    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `guests-${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    window.URL.revokeObjectURL(url);
  }

  // Init
  loadAll();
</script>

</body>
</html>
