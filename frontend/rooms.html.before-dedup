<!-- ================= SCRIPTS ================= -->
<script src="https://cdn.jsdelivr.net/npm/axios@1.7.7/dist/axios.min.js"></script>
<script>
  const API_BASE_URL = "http://localhost:8080/api";
  const api = axios.create({ baseURL: API_BASE_URL });
  let allRooms = [];

  /* NAV AUTH */
  function loadNavAuth() {
    const user = JSON.parse(localStorage.getItem("user") || "null");
    const navAuth = document.getElementById("navAuth");
    if (user) {
      const firstName = user.name ? user.name.split(" ")[0] : "Guest";
      navAuth.innerHTML = `
        <a href="my-bookings.html" class="hidden md:inline text-white text-sm no-underline hover:text-gold">
          <i class="fa-solid fa-calendar-check mr-1"></i>My Bookings
        </a>
        ${user.role === "ADMIN" ? `<a href="admin.html" class="hidden md:inline text-white text-sm no-underline hover:text-gold"><i class="fa-solid fa-gauge mr-1"></i>Admin</a>` : ""}
        <div class="hidden md:flex items-center gap-3 pl-3 border-l border-white/20">
          <span class="text-white text-sm">Hi, ${firstName}</span>
          <button onclick="logout()" class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded-lg text-sm border-0">
            <i class="fa-solid fa-right-from-bracket"></i>
          </button>
        </div>`;
    } else {
      navAuth.innerHTML = `
        <div class="hidden md:flex items-center gap-3">
          <a href="login.html" class="text-white text-sm no-underline hover:text-gold">Login</a>
          <a href="register.html" class="bg-gold hover:bg-[#b28e55] text-white px-5 py-2.5 rounded-full font-semibold text-sm no-underline">Register</a>
        </div>`;
    }
  }

  function logout() { localStorage.clear(); window.location.href = "index.html"; }

  /* MOBILE MENU */
  document.getElementById("mobileMenuBtn").addEventListener("click", function () {
    document.getElementById("mobileMenu").classList.toggle("hidden");
  });

  /* HERO CAROUSEL */
  let heroIndex = 0;
  const heroSlides = document.querySelectorAll(".hero-slide");
  const heroDots = document.querySelectorAll(".hero-dot");
  const heroProgress = document.getElementById("heroProgress");
  const HERO_DURATION = 5000;
  let heroInterval;

  function showHeroSlide(index) {
    heroSlides.forEach(s => s.classList.remove("active"));
    heroDots.forEach(d => d.classList.remove("active"));
    heroIndex = index;
    if (heroSlides[heroIndex]) heroSlides[heroIndex].classList.add("active");
    if (heroDots[heroIndex]) heroDots[heroIndex].classList.add("active");
    resetHeroTimer();
  }

  function resetHeroTimer() {
    clearInterval(heroInterval);
    if (heroProgress) {
      heroProgress.style.transition = "none";
      heroProgress.style.width = "0%";
      setTimeout(() => {
        heroProgress.style.transition = `width ${HERO_DURATION}ms linear`;
        heroProgress.style.width = "100%";
      }, 50);
    }
    heroInterval = setInterval(nextHeroSlide, HERO_DURATION);
  }

  function nextHeroSlide() { let n = heroIndex + 1; if (n >= heroSlides.length) n = 0; showHeroSlide(n); }
  function prevHeroSlide() { let p = heroIndex - 1; if (p < 0) p = heroSlides.length - 1; showHeroSlide(p); }

  const heroSection = document.querySelector(".hero-carousel");
  if (heroSection) {
    heroSection.addEventListener("mouseenter", () => { clearInterval(heroInterval); if (heroProgress) heroProgress.style.transition = "none"; });
    heroSection.addEventListener("mouseleave", resetHeroTimer);
  }

  if (heroSlides.length > 0) resetHeroTimer();

  /* ROOM IMAGES */
  const images = {
    Single: "https://images.unsplash.com/photo-1566665797739-1674de7a421a?w=900&q=85",
    Double: "https://images.unsplash.com/photo-1611892440504-42a792e24d32?w=900&q=85",
    Deluxe: "https://images.unsplash.com/photo-1590490360182-c33d57733427?w=900&q=85",
    Suite: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=900&q=85"
  };

  /* LOAD ROOMS */
  async function loadRooms() {
    try {
      const response = await api.get("/rooms");
      allRooms = response.data.data || [];
      document.getElementById("loading").classList.add("hidden");
      renderRooms(allRooms);
    } catch (error) {
      console.error("Room loading error:", error);
      document.getElementById("loading").innerHTML = `
        <div class="max-w-md mx-auto">
          <div class="w-20 h-20 bg-red-50 rounded-full mx-auto flex items-center justify-center mb-5">
            <i class="fa-solid fa-server text-red-400 text-2xl"></i>
          </div>
          <h3 class="font-serif text-2xl font-semibold text-navy mb-2">Unable to load rooms</h3>
          <p class="text-gray-500 text-sm mb-4">Please make sure the backend is running.</p>
          <div class="bg-gray-100 rounded-xl p-4 text-left text-xs text-gray-500">
            <strong>Backend:</strong><br>mvn spring-boot:run
          </div>
        </div>`;
      document.getElementById("resultCount").textContent = "Unable to connect.";
    }
  }

  /* FILTER */
  function getFilteredRooms() {
    const type = document.getElementById("filterType").value;
    const price = parseFloat(document.getElementById("filterPrice").value) || Infinity;
    const capacity = parseInt(document.getElementById("filterCapacity").value) || 0;
    let filtered = allRooms.filter(room => {
      if (type && room.roomType !== type) return false;
      if (room.price > price) return false;
      if (capacity && room.capacity < capacity) return false;
      return true;
    });
    const sort = document.getElementById("sortRooms").value;
    if (sort === "low") filtered.sort((a, b) => Number(a.price) - Number(b.price));
    else if (sort === "high") filtered.sort((a, b) => Number(b.price) - Number(a.price));
    else if (sort === "capacity") filtered.sort((a, b) => Number(b.capacity) - Number(a.capacity));
    return filtered;
  }

  function applyFilters() { renderRooms(getFilteredRooms()); }

  function clearFilters() {
    document.getElementById("filterType").value = "";
    document.getElementById("filterPrice").value = "";
    document.getElementById("filterCapacity").value = "";
    document.getElementById("sortRooms").value = "recommended";
    renderRooms(allRooms);
  }

  /* RENDER ROOMS */
  function renderRooms(rooms) {
    const grid = document.getElementById("roomsGrid");
    const empty = document.getElementById("empty");
    const count = document.getElementById("resultCount");
    count.textContent = `${rooms.length} ${rooms.length === 1 ? "room" : "rooms"} available`;

    if (!rooms.length) {
      grid.innerHTML = "";
      empty.classList.remove("hidden");
      return;
    }
    empty.classList.add("hidden");

    grid.innerHTML = rooms.map((room, index) => {
      const isAvailable = room.status === "AVAILABLE";
      const image = room.imageUrl || images[room.roomType] || images.Single;
      const price = Number(room.price || 0).toLocaleString();
      const rating = room.rating || "4.8";
      const reviews = room.reviews || Math.floor(70 + Math.random() * 160);
      const description = room.description || getDefaultDescription(room.roomType);
      const bed = getBedType(room.roomType);

      return `
        <article class="room-card rounded-[1.6rem] overflow-hidden fade-up" style="animation-delay:${index * 70}ms">
          <div class="room-image-wrap">
            <img src="${image}" alt="${room.roomType}" class="room-image" loading="lazy">
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
            <div class="absolute top-4 left-4"><span class="badge-room">${room.roomType || "Room"}</span></div>
            <button class="wishlist absolute top-4 right-4" onclick="toggleWishlist(this)"><i class="fa-regular fa-heart"></i></button>
            <div class="absolute bottom-4 left-4">
              <span class="${isAvailable ? "status-available" : "status-unavailable"} px-3 py-1.5 rounded-full text-xs font-bold">
                <i class="fa-solid ${isAvailable ? "fa-circle-check" : "fa-circle-xmark"} mr-1"></i>
                ${isAvailable ? "Available" : "Fully Booked"}
              </span>
            </div>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-serif text-2xl font-semibold text-navy mb-1">${room.roomType || "Premium Room"}</h3>
                <div class="text-xs text-gray-400">Room ${room.roomNumber || "—"}</div>
              </div>
              <div class="text-right">
                <div class="rating-stars text-xs">★★★★★</div>
                <div class="text-[11px] text-gray-400 mt-1">${rating} · ${reviews} reviews</div>
              </div>
            </div>
            <p class="text-gray-500 text-sm leading-6 mt-4 mb-5">${description}</p>
            <div class="grid grid-cols-2 gap-y-3 mb-5">
              <span class="amenity"><i class="fa-solid fa-user"></i>${room.capacity || 1} Guests</span>
              <span class="amenity"><i class="fa-solid fa-bed"></i>${bed}</span>
              <span class="amenity"><i class="fa-solid fa-ruler-combined"></i>${getRoomSize(room.roomType)}</span>
              <span class="amenity"><i class="fa-solid fa-wifi"></i>Free Wi-Fi</span>
              <span class="amenity"><i class="fa-solid fa-snowflake"></i>Air Conditioning</span>
              <span class="amenity"><i class="fa-solid fa-mug-hot"></i>Breakfast</span>
            </div>
            <div class="border-t border-gray-100 pt-4 mb-5">
              <div class="flex items-center gap-2 text-xs text-gray-500 mb-2">
                <i class="fa-solid fa-circle-check text-green-600"></i>Free cancellation
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <i class="fa-solid fa-circle-check text-green-600"></i>Secure reservation
              </div>
            </div>
            <div class="border-t border-gray-100 pt-5 flex items-end justify-between gap-4">
              <div>
                <div class="price text-3xl font-bold text-navy">৳${price}</div>
                <div class="text-xs text-gray-400 mt-1">per night</div>
              </div>
              <div class="flex gap-2">
                <a href="room-detail.html?id=${room.id}" class="btn-outline-navy no-underline px-4 py-2.5 rounded-xl font-semibold text-xs">Details</a>
                <a href="${isAvailable ? `room-detail.html?id=${room.id}` : "#"}" class="${isAvailable ? "btn-gold" : "bg-gray-200 text-gray-400 pointer-events-none"} no-underline px-4 py-2.5 rounded-xl font-semibold text-xs">
                  ${isAvailable ? "Book Now" : "Unavailable"}
                </a>
              </div>
            </div>
          </div>
        </article>`;
    }).join("");
  }

  /* HELPERS */
  function getDefaultDescription(type) {
    const d = {
      Single: "A quiet and comfortable room designed for solo travellers seeking a relaxing stay.",
      Double: "A welcoming room with generous space and comfort for couples or two guests.",
      Deluxe: "An elevated room experience combining elegant interiors, extra space and premium comfort.",
      Suite: "Our most spacious stay featuring refined interiors, relaxing spaces and a luxurious atmosphere."
    };
    return d[type] || "A thoughtfully designed room offering comfort, convenience and a relaxing hotel experience.";
  }

  function getBedType(type) {
    if (type === "Single") return "Single Bed";
    if (type === "Double") return "Queen Bed";
    if (type === "Deluxe") return "King Bed";
    if (type === "Suite") return "King Bed";
    return "Comfort Bed";
  }

  function getRoomSize(type) {
    if (type === "Single") return "20 m²";
    if (type === "Double") return "28 m²";
    if (type === "Deluxe") return "35 m²";
    if (type === "Suite") return "50 m²";
    return "30 m²";
  }

  /* WISHLIST */
  function toggleWishlist(button) {
    const icon = button.querySelector("i");
    if (icon.classList.contains("fa-regular")) {
      icon.classList.remove("fa-regular"); icon.classList.add("fa-solid");
      button.style.color = "#dc3545";
    } else {
      icon.classList.remove("fa-solid"); icon.classList.add("fa-regular");
      button.style.color = "";
    }
  }

  /* STATS COUNTER */
  const statObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !entry.target.dataset.started) {
        entry.target.dataset.started = "true";
        animateStat(entry.target);
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll(".stat-number").forEach(el => statObserver.observe(el));

  function animateStat(el) {
    const target = parseFloat(el.dataset.target);
    const suffix = el.dataset.suffix || "";
    const decimal = parseInt(el.dataset.decimal || "0");
    if (!target) { el.classList.add("visible"); return; }
    el.classList.add("visible");
    const duration = 2000;
    const steps = 60;
    const stepTime = duration / steps;
    let current = 0;
    const inc = target / steps;
    const timer = setInterval(() => {
      current += inc;
      if (current >= target) { current = target; clearInterval(timer); }
      el.textContent = (decimal > 0 ? current.toFixed(decimal) : Math.floor(current)) + suffix;
    }, stepTime);
  }

  /* TESTIMONIALS */
  const testimonialData = [
    { image:"https://randomuser.me/api/portraits/women/44.jpg", name:"Sarah Johnson", location:"London, UK", text:"The room was beautiful, spotless, and incredibly comfortable. Booking was simple and the entire experience felt premium." },
    { image:"https://randomuser.me/api/portraits/men/32.jpg", name:"David Miller", location:"New York, USA", text:"I loved how easy it was to compare rooms before booking. The Deluxe room was exactly as shown in the photos." },
    { image:"https://randomuser.me/api/portraits/women/68.jpg", name:"Emily Carter", location:"Toronto, Canada", text:"Perfect for our family vacation. The staff were friendly, the room was spacious, and everything felt thoughtfully managed." },
    { image:"https://randomuser.me/api/portraits/men/75.jpg", name:"Michael Wilson", location:"Sydney, Australia", text:"The booking process was incredibly smooth. The room was modern, quiet and exactly what I needed after a long flight." },
    { image:"https://randomuser.me/api/portraits/women/65.jpg", name:"Olivia Brown", location:"Dubai, UAE", text:"Amazing experience from check-in to checkout. The service was excellent and the hotel atmosphere was beautiful." },
    { image:"https://randomuser.me/api/portraits/men/46.jpg", name:"James Anderson", location:"Singapore", text:"Great hotel for business travel. Fast Wi-Fi, comfortable workspace and a very peaceful room." }
  ];

  const track = document.getElementById("testimonialTrack");
  const dotsContainer = document.getElementById("testimonialDots");
  const slidesPerView = window.innerWidth >= 1024 ? 3 : (window.innerWidth >= 768 ? 2 : 1);
  const totalSlides = Math.ceil(testimonialData.length / slidesPerView);

  let cardsHTML = "";
  for (let i = 0; i < testimonialData.length; i += slidesPerView) {
    const items = testimonialData.slice(i, i + slidesPerView);
    cardsHTML += `<div class="testimonial-slide"><div class="grid ${slidesPerView === 3 ? 'md:grid-cols-3' : slidesPerView === 2 ? 'md:grid-cols-2' : 'grid-cols-1'} gap-6">`;
    items.forEach(item => {
      cardsHTML += `
        <div class="testimonial-card">
          <div class="flex items-center gap-4 mb-5">
            <img src="${item.image}" class="w-14 h-14 rounded-full object-cover" alt="${item.name}">
            <div>
              <div class="font-bold">${item.name}</div>
              <div class="text-xs text-gray-500">${item.location}</div>
            </div>
            <span class="ml-auto text-teal text-xs"><i class="fa-solid fa-circle-check"></i> Verified</span>
          </div>
          <div class="rating-stars text-sm mb-3">★★★★★</div>
          <p class="text-gray-600 leading-relaxed text-sm">"${item.text}"</p>
        </div>`;
    });
    cardsHTML += `</div></div>`;
  }
  track.innerHTML = cardsHTML;

  for (let i = 0; i < totalSlides; i++) {
    const dot = document.createElement("button");
    dot.className = `testimonial-dot ${i === 0 ? 'active' : ''}`;
    dot.onclick = () => goToTestimonial(i);
    dotsContainer.appendChild(dot);
  }

  let testimonialIndex = 0;
  function goToTestimonial(index) {
    testimonialIndex = index;
    track.style.transform = `translateX(-${index * 100}%)`;
    Array.from(dotsContainer.children).forEach((dot, i) => {
      dot.className = `testimonial-dot ${i === index ? 'active' : ''}`;
    });
  }
  function slideTestimonial(dir) {
    testimonialIndex += dir;
    if (testimonialIndex < 0) testimonialIndex = totalSlides - 1;
    if (testimonialIndex >= totalSlides) testimonialIndex = 0;
    goToTestimonial(testimonialIndex);
  }
  setInterval(() => slideTestimonial(1), 6000);

  /* NEWSLETTER */
  function newsletterSubscribed(form) {
    form.innerHTML = `<div class="text-green-400 font-semibold py-4"><i class="fa-solid fa-circle-check mr-2"></i>Subscribed! Check your inbox.</div>`;
  }

  /* FILTER EVENTS */
  document.getElementById("filterType").addEventListener("change", applyFilters);
  document.getElementById("filterPrice").addEventListener("input", applyFilters);
  document.getElementById("filterCapacity").addEventListener("change", applyFilters);
  document.getElementById("sortRooms").addEventListener("change", applyFilters);

  /* INIT */
  loadNavAuth();
  loadRooms();
  goToTestimonial(0);

    /* ================= FAQ ================= */
    function toggleFaq(button) {
      const item = button.parentElement;
      const answer = button.nextElementSibling;
      const icon = button.querySelector('.faq-icon');
      
      // Close all others
      document.querySelectorAll('.faq-answer').forEach(a => {
        if (a !== answer) {
          a.style.maxHeight = null;
          const otherIcon = a.previousElementSibling.querySelector('.faq-icon');
          if (otherIcon) {
            otherIcon.style.transform = 'rotate(0deg)';
            otherIcon.style.background = '#F8F6F1';
            otherIcon.style.color = '';
          }
        }
      });
      
      if (answer.style.maxHeight && answer.style.maxHeight !== '0px') {
        answer.style.maxHeight = null;
        icon.style.transform = 'rotate(0deg)';
        icon.style.background = '#F8F6F1';
        icon.style.color = '';
      } else {
        answer.style.maxHeight = answer.scrollHeight + 'px';
        icon.style.transform = 'rotate(135deg)';
        icon.style.background = '#C7A46A';
        icon.style.color = 'white';
      }
    }
    
</script>

</body>
</html>
