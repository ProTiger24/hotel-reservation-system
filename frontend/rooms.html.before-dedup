  <section id="faq" class="py-20 bg-[#F8F6F1]">
    <div class="max-w-5xl mx-auto px-5 lg:px-8">
      <div class="text-center mb-14">
        <div class="text-gold text-xs uppercase tracking-[3px] font-bold mb-3">FAQ</div>
        <h2 class="font-serif text-4xl md:text-5xl font-semibold text-navy mb-4">
